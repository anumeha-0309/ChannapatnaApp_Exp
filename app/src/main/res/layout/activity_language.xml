<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="@color/background_white">

    <com.google.android.material.appbar.MaterialToolbar
        android:id="@+id/toolbar"
        android:layout_width="match_parent"
        android:layout_height="?attr/actionBarSize"
        app:navigationIcon="@android:drawable/ic_menu_revert"
        app:navigationIconTint="@color/purple_primary"
        android:visibility="gone" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical"
        android:gravity="center"
        android:padding="32dp">

        <ImageView
            android:layout_width="100dp"
            android:layout_height="100dp"
            android:src="@drawable/ic_launcher_foreground"
            app:tint="@color/purple_primary"
            android:contentDescription="@string/app_logo"
            android:layout_marginBottom="24dp"/>

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/choose_language"
            android:textSize="24sp"
            android:textStyle="bold"
            android:textColor="@color/purple_primary"
            android:layout_marginBottom="40dp"
            android:fontFamily="sans-serif-medium"/>

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnEnglish"
            style="@style/Widget.Material3.Button.TonalButton"
            android:layout_width="match_parent"
            android:layout_height="60dp"
            android:text="@string/english"
            android:layout_marginBottom="16dp"
            app:cornerRadius="12dp"
            app:backgroundTint="@color/purple_light"
            android:textColor="@color/purple_primary_variant"/>

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnHindi"
            style="@style/Widget.Material3.Button.TonalButton"
            android:layout_width="match_parent"
            android:layout_height="60dp"
            android:text="@string/hindi"
            android:layout_marginBottom="16dp"
            app:cornerRadius="12dp"
            app:backgroundTint="@color/purple_light"
            android:textColor="@color/purple_primary_variant"/>

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnKannada"
            style="@style/Widget.Material3.Button.TonalButton"
            android:layout_width="match_parent"
            android:layout_height="60dp"
            android:text="@string/kannada"
            app:cornerRadius="12dp"
            app:backgroundTint="@color/purple_light"
            android:textColor="@color/purple_primary_variant"/>
    </LinearLayout>

</LinearLayout>